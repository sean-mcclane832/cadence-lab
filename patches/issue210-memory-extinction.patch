diff --git a/tests/test_episodic_extinction.py b/tests/test_episodic_extinction.py
new file mode 100644
index 0000000..8a11417
--- /dev/null
+++ b/tests/test_episodic_extinction.py
@@ -0,0 +1,106 @@
+"""``memory_extinction``: a payment that stops is extinguished; replayed or taught credit is not."""
+
+from __future__ import annotations
+
+import os
+
+import numpy as np
+import pytest
+
+import cadence as cd
+
+
+def episodic(*args, **options) -> cd.Brain:
+    return cd.Brain.compose(*args, **{"memory_choice": True, **options})
+
+
+def one_hot(index: int, width: int, rows: int = 1) -> np.ndarray:
+    x = np.zeros((rows, width))
+    x[:, index] = 1.0
+    return x
+
+
+def place(brain: cd.Brain, x: np.ndarray, action: int) -> float:
+    return float(brain.hippocampus.recall(x)[0, action])
+
+
+def test_the_gene_is_validated_and_off_by_default():
+    assert episodic(3, 2, seed=1).memories["episodic"].extinction == 0.0
+    assert episodic(3, 2, seed=1).memories["episodic"].paid is None
+    with pytest.raises(ValueError, match="memory_extinction needs memory_choice"):
+        cd.Brain.compose(3, 2, seed=1, memory_extinction=0.5)
+    with pytest.raises(ValueError):
+        episodic(3, 2, seed=1, memory_extinction=-0.1)
+    described = episodic(3, 2, seed=1, memory_extinction=0.5).describe()["memories"]["episodic"]
+    assert described["extinction"] == 0.5 and described["paid_memory"]["pre"] == 3
+
+
+def bandit(seed: int, **options) -> tuple[cd.Brain, list[float]]:
+    """Arm 0 pays for 120 trials, then arm 1; the unpaid arm pays nothing (issue 210)."""
+    brain = episodic(1, 2, modules=(16,), seed=seed, arousal=True, **options)
+    x = np.ones((1, 1))
+    action, hits = int(brain.live(x)[0]), []
+    for t in range(240):
+        target = 0 if t < 120 else 1
+        hits.append(float(action == target))
+        action = int(brain.live(x, reward=[1.0 if action == target else 0.0])[0])
+    return brain, hits
+
+
+def test_the_gene_off_is_the_released_brain_exactly():
+    released, hits = bandit(3)
+    off, same = bandit(3, memory_extinction=0.0)
+    assert hits == same
+    np.testing.assert_array_equal(
+        released.hippocampus.consolidated, off.hippocampus.consolidated
+    )
+
+
+def test_a_payment_that_stops_is_extinguished():
+    acquired = {name: 0 for name in ("released", "gene")}
+    for seed in range(6):
+        for name, options in (("released", {}), ("gene", {"memory_extinction": 0.5})):
+            brain, hits = bandit(seed, **options)
+            acquired[name] += np.mean(hits[-40:]) >= 0.8
+    assert acquired["gene"] == 6 and acquired["released"] < 6
+
+
+def test_a_taught_act_outlives_a_zero_outcome_with_the_gene():
+    brain = episodic(3, 3, seed=4, memory_context=0.0, memory_extinction=0.5)
+    start = one_hot(0, 3)
+    brain.step(start, teacher=[2])
+    shown = place(brain, start, 2)
+    assert shown >= 0.5
+    brain._moment = (start.copy(), np.array([2]))  # the shown action was the one executed
+    brain.learn(np.zeros(1), np.zeros(1, bool), start)  # nothing paid, the place unchanged
+    assert place(brain, start, 2) == pytest.approx(shown)
+
+
+def test_a_paid_act_is_extinguished_by_a_zero_outcome_with_the_gene():
+    for extinction, kept in ((0.0, True), (0.5, False)):
+        brain = episodic(3, 3, seed=4, memory_context=0.0, memory_extinction=extinction)
+        start = one_hot(0, 3)
+        brain.act(start)
+        brain._moment = (start.copy(), np.array([2]))
+        brain.learn(np.ones(1), np.zeros(1, bool), start)  # paid directly
+        paid = place(brain, start, 2)
+        assert paid >= 0.5
+        brain.act(start)
+        brain._moment = (start.copy(), np.array([2]))
+        brain.learn(np.zeros(1), np.zeros(1, bool), start)  # the payment did not come
+        assert (place(brain, start, 2) == pytest.approx(paid)) is kept
+
+
+def test_a_saved_brain_with_the_gene_continues_exactly(tmp_path):
+    brain, _ = bandit(1, memory_extinction=0.5)
+    path = brain.save(os.path.join(tmp_path, "brain.npz"))
+    first, second = cd.Brain.load(path), cd.Brain.load(path)
+    records = first.memories["episodic"]
+    assert records.extinction == 0.5
+    np.testing.assert_array_equal(
+        records.paid.consolidated, brain.memories["episodic"].paid.consolidated
+    )
+    x = np.ones((1, 1))
+    for reward in (None, 0.0, 0.0, 1.0, 0.0):
+        options = {} if reward is None else {"reward": [reward]}
+        assert int(first.live(x, **options)[0]) == int(second.live(x, **options)[0])
